{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run check:i18n && npm run build",
  "regions": ["iad1"],
  "build": {
    "env": {
      "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1",
      "I18N_STRICT": "1"
    }
  },
  "github": {
    "silent": true
  }
}
