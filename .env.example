# Copy to `.env.local` for local work; set the same keys in Vercel →
# Project → Settings → Environment Variables for the deployed site.
#
# Every value below is optional. The site builds and runs with all of them
# unset — it just shows an honest gap instead of an invented value. Nothing
# here fabricates proof.

# ---------------------------------------------------------------- public ----
# Production origin, no trailing slash. Drives canonical URLs, hreflang,
# Open Graph and the sitemap. On Vercel, set this to your real domain once
# the domain is attached; a preview deploy can leave it unset.
NEXT_PUBLIC_SITE_URL=https://ridefleet.com

# The tracked demo line. DISPLAY is what gets printed; E164 is what makes a
# `tel:` link render. While E164 is empty, the site prints the masked number
# and ships zero tel: links anywhere — that gating is deliberate.
NEXT_PUBLIC_DEMO_PHONE_DISPLAY=+1 787 XXX-XXXX
NEXT_PUBLIC_DEMO_PHONE_E164=

# Contact mailbox shown in the footer and on the legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=hola@ridefleet.com

# Scheduler embed URL. Empty renders the form-only path on /demo, with the
# space already reserved so switching it on costs no layout shift.
NEXT_PUBLIC_SCHEDULER_URL=

# --------------------------------------------------------------- server ----
# Where POST /api/lead forwards a submitted demo request. Unset, the route
# still validates the payload and logs it, but nothing leaves the server —
# so set this before you take real leads.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# Set to 1 in CI to make `npm run check:i18n` fail the build on any key that
# is missing, empty or orphaned in either locale.
I18N_STRICT=
